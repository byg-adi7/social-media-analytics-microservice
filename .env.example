# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed - these are the actual secrets docker-compose.yml
# reads to run the stack.
#
# Generate a strong random secret for any *_SECRET/*_KEY/*_PASSWORD value
# below with, e.g.:
#   openssl rand -base64 32

# --- Postgres ---
POSTGRES_USER=audience
POSTGRES_PASSWORD=replace-with-a-real-generated-secret
POSTGRES_DB=audienceinsights

# --- Identity ---
# Identity (register/login/password/email verification) is fully delegated
# to Supabase Auth - the frontend talks to Supabase directly. This is only
# used to verify the JWT Supabase issues, locally, on every request. From
# your Supabase project: Project Settings -> API -> JWT Settings ("Legacy
# JWT Secret").
SUPABASE_JWT_SECRET=replace-with-your-supabase-project-jwt-secret

# Signs the OAuth "state" CSRF token used by every platform's connect flow.
OAUTH_STATE_SECRET=replace-with-a-real-generated-secret

# Shared secret this server checks in the X-Webhook-Secret header of every
# Supabase Database Webhook call (Database > Webhooks > table auth.users >
# events Insert/Update/Delete > add this header with the same value on each).
SUPABASE_WEBHOOK_SECRET=replace-with-a-real-generated-secret

# --- Push notifications (Firebase Cloud Messaging) ---
# Disabled by default - in-app notifications work fully either way; this
# only controls whether they're also pushed to registered devices.
# FIREBASE_SERVICE_ACCOUNT_BASE64 is the recommended way to supply
# credentials in a container/PaaS deployment: base64-encode the whole
# service-account JSON key file (e.g. `base64 -w0 service-account.json`)
# and paste the result here. FIREBASE_SERVICE_ACCOUNT_PATH is a local-dev
# alternative (a filesystem path to that same JSON file) and is ignored if
# the base64 var is set.
FIREBASE_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_SERVICE_ACCOUNT_PATH=

# --- Rate limiting ---
# In-memory per-user (or per-IP for unauthenticated requests) token bucket.
# All optional - these are the defaults if left unset.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=120
RATE_LIMIT_REFILL_PERIOD_SECONDS=60

# --- Real platform OAuth integrations ---
# All optional - leave an INTEGRATION_ENABLED flag at false (or the whole
# block blank) to keep that platform served from mock data. Enabling one
# requires registering a real app on that platform's own developer console
# first; see README.md's "Real <Platform> Integration" sections for the
# exact steps (redirect URIs, required scopes, and - for Instagram/Facebook
# specifically - Meta's App Review requirement before real users beyond
# your own app's admins/testers can connect).

YOUTUBE_INTEGRATION_ENABLED=false
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

SPOTIFY_INTEGRATION_ENABLED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

INSTAGRAM_INTEGRATION_ENABLED=false
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

TIKTOK_INTEGRATION_ENABLED=false
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

FACEBOOK_INTEGRATION_ENABLED=false
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
