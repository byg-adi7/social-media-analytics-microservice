# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed - these are the actual secrets docker-compose.yml
# reads to run the stack.
#
# Generate a strong random secret for any *_SECRET/*_KEY/*_PASSWORD value
# below with, e.g.:
#   openssl rand -base64 32

# --- Postgres ---
POSTGRES_USER=audience
POSTGRES_PASSWORD=replace-with-a-real-generated-secret
POSTGRES_DB=audienceinsights

# --- Auth Service ---
# Identity (register/login/password/email verification) is fully delegated
# to Supabase Auth - the frontend talks to Supabase directly. This is only
# used to verify the JWT Supabase issues. From your Supabase project:
# Project Settings -> API -> JWT Settings ("Legacy JWT Secret").
SUPABASE_JWT_SECRET=replace-with-your-supabase-project-jwt-secret

# --- Cross-service ---
# Shared by the Analytics Service and Notification Service to authenticate
# the internal-only /internal/notifications endpoint. Must be identical on
# both sides.
INTERNAL_API_KEY=replace-with-a-real-generated-secret
# Signs the OAuth "state" CSRF token used by every platform's connect flow.
OAUTH_STATE_SECRET=replace-with-a-real-generated-secret

# --- Real platform OAuth integrations ---
# All optional - leave an INTEGRATION_ENABLED flag at false (or the whole
# block blank) to keep that platform served from mock data. Enabling one
# requires registering a real app on that platform's own developer console
# first; see README.md's "Real <Platform> Integration" sections for the
# exact steps (redirect URIs, required scopes, and - for Instagram/Facebook
# specifically - Meta's App Review requirement before real users beyond
# your own app's admins/testers can connect).

YOUTUBE_INTEGRATION_ENABLED=false
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

SPOTIFY_INTEGRATION_ENABLED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

INSTAGRAM_INTEGRATION_ENABLED=false
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

TIKTOK_INTEGRATION_ENABLED=false
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

FACEBOOK_INTEGRATION_ENABLED=false
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
